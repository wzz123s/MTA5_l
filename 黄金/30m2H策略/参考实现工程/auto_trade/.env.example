# MT5 credentials & config for monitor_magic_302025.py
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored — never commit it.
#
# Two ways to set these:
#   (A) Create `auto_trade/.env` next to this file. The script loads it on startup.
#   (B) `setx MT5_ACCOUNT 277752085` in Windows (persists across reboots),
#       or `set MT5_ACCOUNT=277752085` in cmd for the current session only.

# ===== Required: MT5 login =====
MT5_ACCOUNT=277752085
MT5_PASSWORD=your_password_here

# ===== Optional: MT5 connection (defaults shown) =====
MT5_PATH=F:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
MT5_SERVER=Exness-MT5Trial5
MT5_SYMBOL=XAUUSDm
MT5_MAGIC_BASE=302025

# ===== Optional: push notification =====
# Server 酱 (Server Chan) — pushes to your personal WeChat.
# Get SendKey: https://sct.ftqq.com → scan QR → copy key from dashboard.
# Format: SCT2xxxxxxxxxxxxxxxx
# Free tier: 5 pushes/day. Paid tier: ¥9/month via WeChat pay.
# Leave empty to disable.
SERVER_CHAN_SENDKEY=

# Enterprise WeChat (企业微信) — pushes via wecom-cli subprocess.
# Requires: `npm install -g @wecom/cli` + `wecom-cli init` (QR scan once).
# Set to the recipient's userid. To find userids:
#   wecom-cli contact get_userlist '{}' | jq '.result.content[0].text | fromjson | .userlist'
# Leave empty to disable.
WECOM_TARGET_USERID=