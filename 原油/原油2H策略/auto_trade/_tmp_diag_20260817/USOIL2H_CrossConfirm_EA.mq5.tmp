//+------------------------------------------------------------------+
//|                        USOIL2H_CrossConfirm_EA.mq5               |
//|                                                         Codex    |
//|  USOIL 2H standalone (matches Python validate_usoil_2h_standalone|
//|  cross_confirm variant, 2026-08-15):                             |
//|    Signal : 2H SMMA5/SMMA13 cross bar (raw good/bad)             |
//|    Confirm: next 2 bars way_s_way & vol_way_s_way (merged seg,   |
//|             min_len=8) both >= 0.5 in trade direction            |
//|    Entry  : open of bar+3 (i+3), prev-segment SMMA13 extreme     |
//|             stop, stop pct in [0.1,1.0] of price                 |
//|    Exit   : SL (open-gap then low/high) or opposite raw cross    |
//|             -> exit at next bar open; single segment             |
//|  Risk    : 1% virtual balance, SimMode only, no real orders      |
//+------------------------------------------------------------------+
#property copyright "Codex"
#property version   "1.00"
#property strict

input group "=== Account ==="
input ulong   InpMagic      = 362036;      // Magic Number
input string  InpSymbol     = "USOILm";    // Symbol

input group "=== Risk & Virtual Position ==="
input double  InpRiskPct    = 1.0;         // Risk % per trade (virtual)
input double  InpStopLoPct  = 0.1;         // Min stop distance (% of price)
input double  InpStopHiPct  = 1.0;         // Max stop distance (% of price)
input int     InpMaxOpenVirtual = 20;      // Max concurrent virtual trades
input double  InpMinLots    = 0.01;        // Min lot
input double  InpMaxLots    = 10.0;        // Max lot
input double  InpSimStartBalance = 500.0;  // Virtual start balance for SimMode

input group "=== Strategy ==="
input int     InpSMA5       = 5;           // 2H SMMA5 period
input int     InpSMA13      = 13;          // 2H SMMA13 period
input int     InpMergedMinLen = 8;         // merged segment min length (Python min_len)
input double  InpConfirmThr = 0.5;         // way/vol_way confirm threshold (fraction)
input int     InpVolMaPeriod = 120;        // volume MA period (rolling mean)

input group "=== Runtime ==="
input int     InpHistoryBars = 600;        // H2 bars to load
input bool    InpSimMode     = true;       // true=virtual only (SAFE)
input bool    InpAllowRealTrading = false; // must be true for real orders (guard)
input bool    InpExportCSV   = true;       // signals CSV
input bool    InpExportLedger = true;      // trade ledger CSV
input bool    InpVerboseDiag = true;       // verbose per-bar diagnostics

//--- globals
string g_signals_csv  = "USOIL2H_crossconfirm_signals_export.csv";
string g_ledger_csv   = "USOIL2H_crossconfirm_trade_ledger.csv";
datetime g_last_bar   = 0;
int      g_bar_seq    = 0;
double   g_virtual_balance = 0.0;

//--- pending candidate: cross bar just closed, waiting for 2 confirm bars
struct Candidate
{
   datetime cross_close;   // cross bar close time (entry bar opens cross_close+4h)
   int      dir;           // +1 LONG, -1 SHORT
   double   stop;
   int      age;           // bars elapsed since cross bar closed (entry at age==2)
};
Candidate g_cands[];

//--- virtual trade
struct VirtualTrade
{
   datetime signal_time;
   datetime entry_time;
   int      dir;           // +1 LONG, -1 SHORT
   double   entry;
   double   stop;
   int      open_seq;      // bar seq when opened (entry bar forming)
   bool     exit_pending;  // opposite cross seen -> exit at next bar open
   bool     closed;
};
VirtualTrade g_trades[];

//+------------------------------------------------------------------+
//| CSV helpers                                                      |
//+------------------------------------------------------------------+
int CsvHandle(string fname)
{
   return FileOpen(fname, FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
}

void CsvSignalsHeader()
{
   int h = CsvHandle(g_signals_csv);
   if(h != INVALID_HANDLE)
   {
      FileWrite(h, "bar_time", "dir", "kind", "entry_next", "stop", "stop_pct",
                "w1", "w2", "v1", "v2", "decision");
      FileClose(h);
   }
}

void CsvLedgerHeader()
{
   int h = CsvHandle(g_ledger_csv);
   if(h != INVALID_HANDLE)
   {
      FileWrite(h, "signal_time", "entry_time", "dir", "entry", "stop", "stop_pct",
                "exit_time", "exit_price", "reason", "pnl_points", "pnl_usd", "virtual_balance");
      FileClose(h);
   }
}

//+------------------------------------------------------------------+
//| SMMA (mean-init), matches processing.smma.calc_smma               |
//+------------------------------------------------------------------+
bool CalcSmmaArray(const MqlRates &r[], int n, int period, double &out[])
{
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) out[i] = 0.0;
   if(n < period) return false;
   double sum = 0.0;
   for(int i = 0; i < period; i++) sum += r[i].close;
   out[period - 1] = sum / period;
   for(int i = period; i < n; i++)
      out[i] = (r[i].close + (period - 1) * out[i - 1]) / period;
   return true;
}

//+------------------------------------------------------------------+
//| Raw direction codes: good=2, bad=-2, up=1, down=-1                |
//+------------------------------------------------------------------+
void BuildRawCodes(const double &fast[], const double &slow[], int n, int &codes[])
{
   ArrayResize(codes, n);
   if(n <= 0) return;
   bool prev_above = fast[0] > slow[0];
   codes[0] = prev_above ? 1 : -1;
   for(int i = 1; i < n; i++)
   {
      bool curr_above = fast[i] > slow[i];
      if(curr_above && !prev_above) codes[i] = 2;
      else if(!curr_above && prev_above) codes[i] = -2;
      else if(curr_above) codes[i] = 1;
      else codes[i] = -1;
      prev_above = curr_above;
   }
}

//+------------------------------------------------------------------+
//| Merged direction codes (chain absorption, min_len=InpMergedMinLen)|
//+------------------------------------------------------------------+
void BuildMergedCodes(const int &raw[], int n, int &merged[])
{
   ArrayResize(merged, n);
   for(int i = 0; i < n; i++) merged[i] = raw[i];

   int crossings[], cross_types[];
   int cross_count = 0;
   ArrayResize(crossings, n);
   ArrayResize(cross_types, n);
   for(int i = 0; i < n; i++)
   {
      if(MathAbs(raw[i]) == 2)
      {
         crossings[cross_count] = i;
         cross_types[cross_count] = raw[i];
         cross_count++;
      }
   }
   if(cross_count == 0) return;

   int state = (cross_types[0] == 2) ? -1 : 1;
   int i = 0;
   while(i < cross_count)
   {
      int pos = crossings[i];
      int type_ = cross_types[i];
      if(i + 1 >= cross_count) break;
      int next_pos = crossings[i + 1];
      int region_count = 0;
      for(int k = pos + 1; k < next_pos; k++)
      {
         if(type_ == 2 && raw[k] == 1) region_count++;
         if(type_ == -2 && raw[k] == -1) region_count++;
      }
      if(region_count < InpMergedMinLen)
      {
         merged[pos] = state;
         for(int k = pos + 1; k < next_pos; k++) merged[k] = state;
         merged[next_pos] = state;
         for(int s = i + 2; s < cross_count; s++)
         {
            crossings[s - 2] = crossings[s];
            cross_types[s - 2] = cross_types[s];
         }
         cross_count -= 2;
         if(cross_count <= 0) break;
         continue;
      }
      state = (type_ == 2) ? 1 : -1;
      i++;
   }
}

//+------------------------------------------------------------------+
//| FindStop: previous RAW-cross segment SMMA13 extreme (Python)      |
//+------------------------------------------------------------------+
double FindStopSma(const double &sma_f[], const double &sma_s[], int sig_idx, bool is_long)
{
   int k = -1;
   for(int i = sig_idx - 1; i >= 1; i--)
   {
      bool curr_above = sma_f[i] > sma_s[i];
      bool prev_above = sma_f[i - 1] > sma_s[i - 1];
      if(curr_above != prev_above) { k = i; break; }
   }
   if(k < 0) return 0.0;
   double extreme = 0.0;
   for(int i = k; i < sig_idx; i++)
   {
      if(sma_s[i] == 0.0 || !MathIsValidNumber(sma_s[i])) continue;
      if(is_long) extreme = (extreme == 0.0) ? sma_s[i] : MathMin(extreme, sma_s[i]);
      else        extreme = (extreme == 0.0) ? sma_s[i] : MathMax(extreme, sma_s[i]);
   }
   return extreme;
}

//+------------------------------------------------------------------+
//| Rolling volume MA (pandas rolling(period, min_periods=1))         |
//+------------------------------------------------------------------+
void ComputeVolMa(const MqlRates &r[], int n, double &vol_ma[])
{
   ArrayResize(vol_ma, n);
   for(int i = 0; i < n; i++)
   {
      double sum = 0.0;
      int c = 0;
      for(int j = i; j >= 0 && (i - j) < InpVolMaPeriod; j--)
      {
         sum += r[j].tick_volume;
         c++;
      }
      vol_ma[i] = (c > 0) ? sum / c : 0.0;
   }
}

//+------------------------------------------------------------------+
//| way_s_way / vol_way_s_way over MERGED codes (matches add_way_grade)|
//+------------------------------------------------------------------+
void ComputeWayArrays(const MqlRates &r[], int n, const double &sma13[], const int &merged[],
                      const double &vol_ma[], double &way[], double &vol_way[])
{
   ArrayResize(way, n);
   ArrayResize(vol_way, n);
   int y = 0, x = 0, z = 0;
   int prev_d = 0;
   for(int i = 0; i < n; i++)
   {
      int d = merged[i];
      double wsw = 0.0, vwsw = 0.0;
      if(sma13[i] == 0.0 || !MathIsValidNumber(sma13[i])) d = 0; // warmup -> neutral
      if(d == 2 || d == -2)
      {
         y = x = z = 0;
      }
      else if(d == 1)
      {
         if(prev_d == 1)
         {
            y++;
            if(r[i].low >= sma13[i] && r[i].high >= r[i - 1].high) x++;
            if(r[i].tick_volume <= vol_ma[i]) z++;
         }
         else
         {
            y = 1;
            x = 1;
            z = (r[i].tick_volume <= vol_ma[i]) ? 1 : 0;
         }
         wsw = (y != 0) ? NormalizeDouble((double)x / y, 2) : 0.0;
         vwsw = (y != 0) ? NormalizeDouble((double)z / y, 2) : 0.0;
      }
      else if(d == -1)
      {
         if(prev_d == -1)
         {
            y--;
            if(r[i].high <= sma13[i] && r[i].low <= r[i - 1].low) x--;
            if(r[i].tick_volume <= vol_ma[i]) z--;
         }
         else
         {
            y = -1;
            x = -1;
            z = (r[i].tick_volume <= vol_ma[i]) ? -1 : 0;
         }
         wsw = (y != 0) ? NormalizeDouble((double)x / y, 2) : 0.0;
         vwsw = (y != 0) ? NormalizeDouble((double)z / y, 2) : 0.0;
      }
      way[i] = wsw;
      vol_way[i] = vwsw;
      prev_d = d;
   }
}

//+------------------------------------------------------------------+
//| PnL / ledger helpers                                              |
//+------------------------------------------------------------------+
double ContractSize()
{
   return SymbolInfoDouble(InpSymbol, SYMBOL_TRADE_CONTRACT_SIZE);
}

double CalcLot(double stop_price)
{
   double risk = g_virtual_balance * InpRiskPct / 100.0;
   double lot = (stop_price > 0.0) ? risk / (stop_price * ContractSize()) : InpMinLots;
   if(lot < InpMinLots) lot = InpMinLots;
   if(lot > InpMaxLots) lot = InpMaxLots;
   return lot;
}

void RecordExit(int slot, datetime exit_time, double exit_price, string reason)
{
   double pnl_points = (g_trades[slot].dir > 0)
                       ? (exit_price - g_trades[slot].entry)
                       : (g_trades[slot].entry - exit_price);
   double stop = MathAbs(g_trades[slot].entry - g_trades[slot].stop);
   double lot = CalcLot(stop);
   double pnl_usd = lot * pnl_points * ContractSize();
   g_virtual_balance += pnl_usd;

   if(InpExportLedger)
   {
      int h = FileOpen(g_ledger_csv, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
      if(h != INVALID_HANDLE)
      {
         FileSeek(h, 0, SEEK_END);
         FileWrite(h, TimeToString(g_trades[slot].signal_time), TimeToString(g_trades[slot].entry_time),
                   (g_trades[slot].dir > 0 ? "BUY" : "SELL"),
                   DoubleToString(g_trades[slot].entry, 5), DoubleToString(g_trades[slot].stop, 5),
                   DoubleToString(MathAbs(g_trades[slot].entry - g_trades[slot].stop) / g_trades[slot].entry * 100.0, 3),
                   TimeToString(exit_time), DoubleToString(exit_price, 5), reason,
                   DoubleToString(pnl_points, 5), DoubleToString(pnl_usd, 5),
                   DoubleToString(g_virtual_balance, 5));
         FileClose(h);
      }
   }

   if(InpVerboseDiag)
   {
      Print("[SIM] EXIT ", (g_trades[slot].dir > 0 ? "BUY" : "SELL"),
            " signal=", TimeToString(g_trades[slot].signal_time),
            " exit=", TimeToString(exit_time), " px=", DoubleToString(exit_price, 5),
            " reason=", reason, " pnl_pts=", DoubleToString(pnl_points, 5),
            " pnl_usd=", DoubleToString(pnl_usd, 5),
            " balance=", DoubleToString(g_virtual_balance, 5));
   }
}

//+------------------------------------------------------------------+
//| Resolve ready candidates -> open virtual positions                |
//+------------------------------------------------------------------+
void ProcessCandidates(datetime bar0_time, int n, const double &way[], const double &vol_way[])
{
   for(int c = ArraySize(g_cands) - 1; c >= 0; c--)
   {
      g_cands[c].age++;
      if(g_cands[c].age < 2) continue;   // bars i+1,i+2 close at age 1,2; entry bar i+3 opens at age 2
      if(g_cands[c].age == 2 && n >= 4)
      {
         double w1 = way[n - 3];
         double w2 = way[n - 2];
         double v1 = vol_way[n - 3];
         double v2 = vol_way[n - 2];
         int sign = g_cands[c].dir;
         // BUG-1 修复(2026-09-04): way_s_way/vol_way_s_way 无符号 [0,1], 不能乘 sign(否则空单恒不通过)
         bool ok_way = (MathMin(w1, w2) >= InpConfirmThr);
         bool ok_vol = (MathMin(v1, v2) >= InpConfirmThr);
         double entry = iOpen(InpSymbol, PERIOD_H2, 0);
         double r = MathAbs(entry - g_cands[c].stop);
         double pct = (entry > 0.0) ? r / entry * 100.0 : 0.0;
         bool side_ok = (sign > 0) ? (g_cands[c].stop < entry) : (g_cands[c].stop > entry);

         if(ok_way && ok_vol && pct >= InpStopLoPct && pct <= InpStopHiPct && side_ok &&
           ArraySize(g_trades) < InpMaxOpenVirtual)
         {
            int s = ArraySize(g_trades);
            ArrayResize(g_trades, s + 1);
            g_trades[s].signal_time = g_cands[c].cross_close;
            g_trades[s].entry_time = bar0_time;
            g_trades[s].dir = sign;
            g_trades[s].entry = entry;
            g_trades[s].stop = g_cands[c].stop;
            g_trades[s].open_seq = g_bar_seq;
            g_trades[s].exit_pending = false;
            g_trades[s].closed = false;
            if(InpVerboseDiag)
               Print("[SIM] OPEN ", (sign > 0 ? "BUY" : "SELL"),
                     " signal=", TimeToString(g_cands[c].cross_close),
                     " entry=", DoubleToString(entry, 5),
                     " stop=", DoubleToString(g_cands[c].stop, 5),
                     " pct=", DoubleToString(pct, 3),
                     " w1/w2=", DoubleToString(w1, 2), "/", DoubleToString(w2, 2),
                     " v1/v2=", DoubleToString(v1, 2), "/", DoubleToString(v2, 2));
         }
         else
         {
            if(InpVerboseDiag)
               Print("[SKIP] signal=", TimeToString(g_cands[c].cross_close),
                     " dir=", (sign > 0 ? "BUY" : "SELL"),
                     " ok_way=", ok_way, " ok_vol=", ok_vol,
                     " pct=", DoubleToString(pct, 3),
                     " side_ok=", side_ok);
         }

         if(InpExportCSV)
         {
            int h = FileOpen(g_signals_csv, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
            if(h != INVALID_HANDLE)
            {
               FileSeek(h, 0, SEEK_END);
               FileWrite(h, TimeToString(g_cands[c].cross_close),
                         (sign > 0 ? "BUY" : "SELL"), "entry",
                         DoubleToString(iOpen(InpSymbol, PERIOD_H2, 0), 5),
                         DoubleToString(g_cands[c].stop, 5),
                         DoubleToString(pct, 3),
                         DoubleToString(w1, 2), DoubleToString(w2, 2),
                         DoubleToString(v1, 2), DoubleToString(v2, 2),
                         (ok_way && ok_vol && pct >= InpStopLoPct && pct <= InpStopHiPct && side_ok
                          ? "ENTRY" : "SKIP"));
               FileClose(h);
            }
         }
      }
      // remove handled/expired candidate
      for(int k = c; k < ArraySize(g_cands) - 1; k++) g_cands[k] = g_cands[k + 1];
      ArrayResize(g_cands, ArraySize(g_cands) - 1);
   }
}

//+------------------------------------------------------------------+
//| Process open virtual trades on the just-closed bar                |
//+------------------------------------------------------------------+
void ProcessOpenTrades(const MqlRates &rates[], int n, const int &raw[])
{
   for(int s = 0; s < ArraySize(g_trades); s++)
   {
      if(g_trades[s].closed) continue;
      int age = g_bar_seq - g_trades[s].open_seq;
      if(age <= 0) continue;               // entry bar still forming
      int idx = (n - 2) - (age - 1);
      if(idx < 0) continue;
      MqlRates bar = rates[idx];
      bool is_long = g_trades[s].dir > 0;

      bool exit_now = false;
      double exit_px = 0.0;
      string reason = "";
      if(g_trades[s].exit_pending)
      {
         exit_px = bar.open;               // exit at open of bar after opposite cross
         reason = "opposite cross";
         exit_now = true;
      }
      else
      {
         if(is_long)
         {
            if(bar.open <= g_trades[s].stop) { exit_px = bar.open; reason = "SL hit"; exit_now = true; }
            else if(bar.low <= g_trades[s].stop) { exit_px = g_trades[s].stop; reason = "SL hit"; exit_now = true; }
         }
         else
         {
            if(bar.open >= g_trades[s].stop) { exit_px = bar.open; reason = "SL hit"; exit_now = true; }
            else if(bar.high >= g_trades[s].stop) { exit_px = g_trades[s].stop; reason = "SL hit"; exit_now = true; }
         }
         if(!exit_now && ((is_long && raw[idx] == -2) || (!is_long && raw[idx] == 2)))
            g_trades[s].exit_pending = true;
      }
      if(exit_now)
      {
         RecordExit(s, bar.time, exit_px, reason);
         g_trades[s].closed = true;
      }
   }

   int w = 0;
   for(int s = 0; s < ArraySize(g_trades); s++)
   {
      if(!g_trades[s].closed)
      {
         if(w != s) g_trades[w] = g_trades[s];
         w++;
      }
   }
   ArrayResize(g_trades, w);
}

//+------------------------------------------------------------------+
//| OnInit / OnDeinit / OnTick                                        |
//+------------------------------------------------------------------+
int OnInit()
{
   g_virtual_balance = InpSimStartBalance;
   g_last_bar = 0;
   g_bar_seq = 0;
   ArrayResize(g_cands, 0);
   ArrayResize(g_trades, 0);
   if(InpExportCSV) CsvSignalsHeader();
   if(InpExportLedger) CsvLedgerHeader();
   Print("USOIL2H CrossConfirm EA initialized. SimMode=", InpSimMode,
         " AllowRealTrading=", InpAllowRealTrading,
         " Magic=", InpMagic, " VirtualBalance=", DoubleToString(g_virtual_balance, 5));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
}

void OnTick()
{
   if(!InpSimMode && !InpAllowRealTrading) return; // double guard: sim-only

   datetime bar0_time = iTime(InpSymbol, PERIOD_H2, 0);
   if(bar0_time <= 0) return;
   if(bar0_time == g_last_bar) return;
   g_last_bar = bar0_time;
   g_bar_seq++;

   MqlRates rates[];
   int n = CopyRates(InpSymbol, PERIOD_H2, 0, InpHistoryBars, rates);
   if(n < 80) return;

   double sma5[], sma13[];
   if(!CalcSmmaArray(rates, n, InpSMA5, sma5)) return;
   if(!CalcSmmaArray(rates, n, InpSMA13, sma13)) return;
   int raw_codes[], merged[];
   BuildRawCodes(sma5, sma13, n, raw_codes);
   BuildMergedCodes(raw_codes, n, merged);
   double vol_ma[];
   ComputeVolMa(rates, n, vol_ma);
   double way[], vol_way[];
   ComputeWayArrays(rates, n, sma13, merged, vol_ma, way, vol_way);

   // 1) resolve ready candidates (confirm bars = shifts 2,1 -> indices n-3,n-2)
   ProcessCandidates(bar0_time, n, way, vol_way);

   // 2) manage open positions on the just-closed bar
   ProcessOpenTrades(rates, n, raw_codes);

   // 3) detect raw cross on the just-closed bar -> new candidate
   int sig_idx = n - 2;
   int code = raw_codes[sig_idx];
   if(MathAbs(code) == 2)
   {
      bool is_long = (code == 2);
      double stop = FindStopSma(sma5, sma13, sig_idx, is_long);
      if(stop != 0.0 && ArraySize(g_cands) < 20)
      {
         int c = ArraySize(g_cands);
         ArrayResize(g_cands, c + 1);
         g_cands[c].cross_close = rates[sig_idx].time + 2 * 3600; // bar close time
         g_cands[c].dir = is_long ? 1 : -1;
         g_cands[c].stop = stop;
         g_cands[c].age = 0;
         if(InpVerboseDiag)
            Print("[SIGNAL] ", (is_long ? "BUY" : "SELL"),
                  " cross signal_time=", TimeToString(g_cands[c].cross_close),
                  " stop=", DoubleToString(stop, 5),
                  " -> confirm next 2 bars, entry bar+3 open");
         if(InpExportCSV)
         {
            int h = FileOpen(g_signals_csv, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
            if(h != INVALID_HANDLE)
            {
               FileSeek(h, 0, SEEK_END);
               FileWrite(h, TimeToString(g_cands[c].cross_close),
                         (is_long ? "BUY" : "SELL"), "signal",
                         "0", DoubleToString(stop, 5), "0",
                         "0", "0", "0", "0", "CONFIRM_WAIT");
               FileClose(h);
            }
         }
      }
   }
}
//+------------------------------------------------------------------+
